# Copy to .env.local and fill in. Never commit real keys.

# Groq API key for AI report classification (falls back to keyword rules if unset)
GROQ_API_KEY=
# Optional: override the Groq model
GROQ_MODEL=

# Optional: Upstash Redis for persistent reports + rate limiting (Vercel injects KV_REST_API_*)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
